{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.json)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/appsettings.*.local.json)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets.json)",
      "Edit(**/secrets/**)",

      "Read(**/node_modules/**)",

      "Read(**/.idea/**)",

      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/out/**)",
      "Read(**/target/**)",
      "Read(**/coverage/**)",
      "Read(**/artifacts/**)",
      "Read(**/.gradle/**)",
      "Read(**/.angular/**)",
      "Read(**/.nx/**)",
      "Read(**/android/app/build/**)",
      "Read(**/ios/App/Pods/**)",
      "Read(**/*.binlog)",
      "Read(**/*.nupkg)",

      "Read(**/*.jar)",
      "Read(**/*.war)",
      "Read(**/*.class)",
      "Read(**/*.dll)",
      "Read(**/*.exe)",
      "Read(**/*.so)",
      "Read(**/*.dylib)",
      "Read(**/*.apk)",
      "Read(**/*.aab)",
      "Read(**/*.ipa)"
    ]
  }
}
