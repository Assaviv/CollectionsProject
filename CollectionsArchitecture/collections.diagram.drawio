        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-61" value="&lt;h1&gt;UI Server (webapp)&lt;/h1&gt;&lt;p&gt;The entry point between the private browser to the public server. It will display data as special lists and will be able to visualise them or will get visualise by internal service.&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#cce5ff;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1941" y="181" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-62" value="&lt;h1&gt;API Gateway for UI&lt;/h1&gt;&lt;p&gt;The entry point between the UI Server to the internal services. It will route data and send them to the desired service for processing.&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#ffff88;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="2163" y="211" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-63" value="&lt;h1&gt;Accounts Manager&lt;/h1&gt;&lt;p&gt;The service which responsible of registering and removing users to the system, also handling their access roles and privileges.&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#cdeb8b;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1720" y="311" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-64" value="&lt;h1&gt;Collection Manager&lt;/h1&gt;&lt;p&gt;The service which responsible of CRUD collection request, collection sharing and collection auto features i.e. Microsoft RE and Classification. Also will delivered security feature of private lists etc...&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#ffcccc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1941" y="341" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-65" value="&lt;h1&gt;Microsoft RE&lt;/h1&gt;&lt;p&gt;Almost fully built based on Microsoft RE, The unit which will process all user&#39;s custom visualisation abilities.&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#ffcc99;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="2163" y="381" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-66" value="&lt;h1&gt;DBW PostgreSQL&lt;/h1&gt;&lt;p&gt;The Service which will make all the request to PostgreSQL and retrieve the data accordingly. Functions for add user, remove user e.t.c. will be here, functions for login and sign up will be at account manager service&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#ffff88;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1811" y="531" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="7pLNRe2Hsib97gX7ZQOw-69" value="&lt;h1&gt;DBW ElasticSearch&lt;/h1&gt;&lt;p&gt;The Service which will make all the request to ElasticSearch and retrieve the data accordingly. Functions for add list, remove list e.t.c. will be here, functions for shared lists will be at collection manager service&lt;/p&gt;" style="text;html=1;strokeColor=#36393d;fillColor=#cdeb8b;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="2031" y="500" width="230" height="140" as="geometry" />
        </mxCell>
