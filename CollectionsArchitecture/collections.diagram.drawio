        <mxCell id="vCoRx48rwnzp295bSbvz-49" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://uxwing.com/wp-content/themes/uxwing/download/brands-and-social-media/postgresql-icon.png;" value="" vertex="1">
