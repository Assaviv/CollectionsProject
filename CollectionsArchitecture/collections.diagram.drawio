        <mxCell id="vCoRx48rwnzp295bSbvz-48" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://img.icons8.com/color/512/elasticsearch.png;" value="" vertex="1">
