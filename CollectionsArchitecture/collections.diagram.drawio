        </mxCell>
        <mxCell id="G_IqgOCh1BpxfMpsMEvP-66" value="&lt;h1&gt;Mobile&lt;/h1&gt;&lt;p&gt;On edit mode, in the mobile version, the lists will show as a chat when every node is can be typed and send like a message without too much work,&lt;/p&gt;&lt;p&gt;On view mode, in the mobile version it&#39;ll look like the preview&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="842.85" y="180" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G_IqgOCh1BpxfMpsMEvP-67" value="&lt;h1&gt;Web&lt;/h1&gt;&lt;p&gt;On edit mode, in the web version, the lists will show as a chat when every node is can be typed and send like a message without too much work.&lt;/p&gt;&lt;p&gt;There is no view mode because the view is already to the right of the lists&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="842.85" y="502.5" width="190" height="180" as="geometry" />
        </mxCell>
      </root>
