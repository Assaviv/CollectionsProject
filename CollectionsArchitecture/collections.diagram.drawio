        <mxCell id="vCoRx48rwnzp295bSbvz-46" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.iconscout.com/icon/free/png-256/elastic-1-283281.png;" value="" vertex="1">
