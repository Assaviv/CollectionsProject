  <diagram id="NQfYIQrDH8YSFSFdnVB1" name="Services Description">
    <mxGraphModel dx="-774" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="5r6nUvGExAH_rt9K4BVN-1" value="&lt;h1&gt;UI Server (mobile)&lt;/h1&gt;&lt;p&gt;The entry point between the private phone to the public server. It will display data as special lists and will be able to visualise them or will get visualise by internal service.&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1723" y="140" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-2" value="&lt;h1&gt;UI Server (webapp)&lt;/h1&gt;&lt;p&gt;The entry point between the private browser to the public server. It will display data as special lists and will be able to visualise them or will get visualise by internal service.&lt;/p&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1953" y="270" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-3" value="&lt;h1&gt;API Gateway for UI&lt;/h1&gt;&lt;p&gt;The entry point between the UI Server to the internal services. It will route data and send them to the desired service for processing.&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="2183" y="400" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-4" value="&lt;h1&gt;Accounts Manager&lt;/h1&gt;&lt;p&gt;The service which responsible of registering and removing users to the system, also handling their access roles and privileges.&lt;/p&gt;" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1953" y="760" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-5" value="&lt;h1&gt;Collection Manager&lt;/h1&gt;&lt;p&gt;The service which responsible of CRUD collection request, collection sharing and collection auto features i.e. Microsoft RE and Classification. Also will delivered security feature of private lists etc...&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1723" y="630" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-6" value="&lt;h1&gt;Microsoft RE&lt;/h1&gt;&lt;p&gt;Almost fully built based on Microsoft RE, The unit which will process all user&#39;s custom visualisation abilities.&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1953" y="530" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-7" value="&lt;h1&gt;DBW PostgreSQL&lt;/h1&gt;&lt;p&gt;The Service which will make all the request to PostgreSQL and retrieve the data accordingly. Functions for add user, remove user e.t.c. will be here, functions for login and sign up will be at account manager service&lt;/p&gt;" style="text;html=1;strokeColor=#23445d;fillColor=#bac8d3;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1723" y="890" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-8" value="&lt;h1&gt;DBW ElasticSearch&lt;/h1&gt;&lt;p&gt;The Service which will make all the request to ElasticSearch and retrieve the data accordingly. Functions for add list, remove list e.t.c. will be here, functions for shared lists will be at collection manager service&lt;/p&gt;" style="text;html=1;strokeColor=#0e8088;fillColor=#b0e3e6;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="2183" y="890" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-9" value="&lt;h1&gt;Log-stash&lt;/h1&gt;&lt;p&gt;______________________________&lt;/p&gt;&lt;p&gt;_____________________.&lt;/p&gt;" style="text;html=1;fillColor=#999999;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="1953" y="1030" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-10" value="&lt;h1&gt;Classification&lt;/h1&gt;&lt;p&gt;______________________________&lt;/p&gt;&lt;p&gt;_____________________.&lt;/p&gt;" style="text;html=1;fillColor=#999999;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="2183" y="630" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-11" value="&lt;h1&gt;Kibana&lt;/h1&gt;&lt;p&gt;______________________________&lt;/p&gt;&lt;p&gt;_____________________.&lt;/p&gt;" style="text;html=1;fillColor=#999999;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="1723" y="400" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5r6nUvGExAH_rt9K4BVN-12" value="&lt;h1&gt;Caching&lt;/h1&gt;&lt;p&gt;______________________________&lt;/p&gt;&lt;p&gt;_____________________.&lt;/p&gt;" style="text;html=1;fillColor=#999999;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="2183" y="140" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="GHQZiAC_iFTOFuyxkCV1-1" value="&lt;h1&gt;Router&lt;/h1&gt;&lt;p&gt;(Load balancer ) ______________________________&lt;/p&gt;&lt;p&gt;_____________________.&lt;/p&gt;" style="text;html=1;fillColor=#999999;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="1953" y="10" width="230" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
