{
  "realm": "save-app",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "save-app-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://collections-ui-collections.dev.localhost:4200/*"],
      "webOrigins": ["http://collections-ui-collections.dev.localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://collections-ui-collections.dev.localhost:4200/*"
      }
    },
    {
      "clientId": "save-app-mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["com.aviv.saveapp:/auth"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.aviv.saveapp:/auth"
      }
    }
  ],
  "users": [
    {
      "username": "dev@example.com",
      "email": "dev@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dev", "temporary": false }
      ]
    }
  ]
}

